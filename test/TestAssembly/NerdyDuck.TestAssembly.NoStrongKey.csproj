<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>NerdyDuck.TestAssembly</RootNamespace>
    <AssemblyName>TestAssembly</AssemblyName>
    <SignAssembly>false</SignAssembly>
    <OutputType>Library</OutputType>
    <EnableMSTestRunner>false</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>false</TestingPlatformDotnetTestSupport>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="MSTest" />
    <PackageReference Remove="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
