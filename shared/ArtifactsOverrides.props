<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(IsTestProject)' == 'false'">
    <ArtifactsProjectName>assemblies\$(Configuration.ToLowerInvariant())\$(MSBuildProjectName)</ArtifactsProjectName>
    <ArtifactsPivots Condition="'$(TargetFrameworks)' != '' And '$(TargetFramework)' != ''">$(TargetFramework.ToLowerInvariant())</ArtifactsPivots>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <ArtifactsProjectName>test\$(Configuration.ToLowerInvariant())\$(MSBuildProjectName)</ArtifactsProjectName>
    <ArtifactsPivots Condition="'$(TargetFrameworks)' != '' And '$(TargetFramework)' != ''">$(TargetFramework.ToLowerInvariant())</ArtifactsPivots>
  </PropertyGroup>
</Project>
